{
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    /* Transpiling with TSUP or Parcel (not TypeScript itself) */
    "module": "preserve",
    "noEmit": true,

    /* Code runs in the DOM: */
    "lib": ["es2022", "dom", "dom.iterable"],

    /* React specific */
    "jsx": "react-jsx",

    /* Testing types */
    "types": ["vitest/globals"]
  },
  "include": ["src", "tests", "./*.js", "./*.ts", "packages/**/*.tsx"]
}
